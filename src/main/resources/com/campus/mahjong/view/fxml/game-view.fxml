<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.campus.mahjong.controller.page.GameController" styleClass="game-root">
    <BorderPane maxWidth="1440" styleClass="game-shell">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="game-top">
                <VBox spacing="1"><Label fx:id="roundLabel" styleClass="game-round"/><Label fx:id="roomLabel" styleClass="game-meta"/></VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="scoreLabel" styleClass="score-chip"/>
                <Label fx:id="wallLabel" styleClass="wall-chip"/>
                <Button text="返回首页" onAction="#returnHome" styleClass="ghost-button"/>
            </HBox>
        </top>
        <center>
            <StackPane prefHeight="610" styleClass="table-wrap">
                <VBox alignment="CENTER" spacing="13" maxWidth="360" styleClass="table-center">
                    <Label fx:id="actionTip" styleClass="turn-tip" wrapText="true"/>
                </VBox>
                <Label fx:id="topPlayerLabel" translateX="22" translateY="20" StackPane.alignment="TOP_LEFT" styleClass="opponent-name"/>
                <Label fx:id="rightPlayerLabel" translateX="-22" translateY="20" StackPane.alignment="TOP_RIGHT" styleClass="opponent-name"/>
                <Label fx:id="leftPlayerLabel" translateX="22" translateY="-28" StackPane.alignment="BOTTOM_LEFT" styleClass="opponent-name"/>
                <FlowPane fx:id="topDiscardPane" alignment="CENTER" hgap="2" vgap="2" prefWrapLength="188" maxWidth="194" rotate="180" translateY="-150" StackPane.alignment="TOP_CENTER" styleClass="seat-discard-area north-discard-area"/>
                <FlowPane fx:id="leftDiscardPane" alignment="CENTER" hgap="2" vgap="2" prefWrapLength="188" maxWidth="194" rotate="90" translateX="166" StackPane.alignment="CENTER_LEFT" styleClass="seat-discard-area side-discard-area"/>
                <FlowPane fx:id="rightDiscardPane" alignment="CENTER" hgap="2" vgap="2" prefWrapLength="188" maxWidth="194" rotate="-90" translateX="-166" StackPane.alignment="CENTER_RIGHT" styleClass="seat-discard-area side-discard-area"/>
                <FlowPane fx:id="bottomDiscardPane" alignment="CENTER" hgap="2" vgap="2" prefWrapLength="188" maxWidth="194" translateY="130" StackPane.alignment="BOTTOM_CENTER" styleClass="seat-discard-area south-discard-area"/>
                <VBox alignment="BOTTOM_CENTER" spacing="6" translateY="-5" StackPane.alignment="BOTTOM_CENTER" styleClass="local-table-dock">
                    <HBox alignment="CENTER_RIGHT" maxWidth="1180"><Label fx:id="selectedTileLabel" text="尚未选牌" styleClass="selected-tile-label"/></HBox>
                    <HBox alignment="CENTER" spacing="16" maxWidth="1240">
                        <HBox fx:id="handPane" alignment="CENTER" spacing="5"/>
                        <HBox fx:id="meldPane" alignment="CENTER_LEFT" spacing="10" styleClass="meld-area"/>
                    </HBox>
                    <HBox alignment="CENTER" spacing="10">
                        <Button fx:id="passButton" text="过" onAction="#passAction" styleClass="action-button"/>
                        <Button fx:id="pengButton" text="碰" onAction="#pengAction" styleClass="action-button"/>
                        <Button fx:id="gangButton" text="杠" onAction="#gangAction" styleClass="action-button"/>
                        <Button fx:id="discardButton" text="打出选中牌" onAction="#discardSelected" disable="true" styleClass="secondary-button"/>
                        <Button fx:id="huButton" text="胡" onAction="#winRound" styleClass="primary-button"/>
                    </HBox>
                </VBox>
                <Label fx:id="playerLabel" translateX="-22" translateY="-28" StackPane.alignment="BOTTOM_RIGHT" styleClass="player-self"/>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
