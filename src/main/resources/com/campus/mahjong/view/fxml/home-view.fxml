<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.campus.mahjong.controller.page.HomeController" styleClass="app-root">
    <BorderPane maxWidth="1440" styleClass="page-shell">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="top-bar">
                <StackPane styleClass="brand-seal"><Label text="雀" styleClass="brand-seal-text"/></StackPane>
                <VBox spacing="1"><Label text="雀 隐" styleClass="brand-title"/><Label text="好友联机麻将" styleClass="brand-subtitle"/></VBox>
                <Label text="好友房" styleClass="offline-badge"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="创建房间 · 邀请好友 · 多电脑联机" styleClass="local-tip"/>
                <Button text="设置" styleClass="ghost-button"/>
            </HBox>
        </top>
        <center>
            <HBox alignment="CENTER" spacing="26">
                <padding><Insets top="24" right="38" bottom="24" left="38"/></padding>
                <VBox spacing="17" prefWidth="620" maxWidth="660" HBox.hgrow="ALWAYS">
                    <VBox spacing="4">
                        <Label text="和熟悉的人，打一场好牌" styleClass="eyebrow"/>
                        <Label text="开一间好友房，等大家入座" styleClass="hero-title" wrapText="true"/>
                        <Label text="房主创建房间后分享 6 位房间码。好友可在不同电脑上加入、准备并同步进行牌局。" styleClass="hero-description" wrapText="true"/>
                    </VBox>
                    <VBox spacing="12" styleClass="content-card">
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="1"><Label text="选择玩法" styleClass="section-title"/><Label text="房主确定本房间的规则" styleClass="section-subtitle"/></VBox>
                            <Region HBox.hgrow="ALWAYS"/><Label fx:id="modeHintLabel" text="已选择 四川麻将" styleClass="selected-hint"/>
                        </HBox>
                        <GridPane hgap="12" vgap="12">
                            <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                            <Button fx:id="sichuan" text="川  四川麻将\n血战到底 · 节奏明快" onAction="#chooseMode" maxWidth="Infinity" styleClass="mode-card,selected" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Button fx:id="changsha" text="湘  长沙麻将\n番型丰富 · 有碰有趣" onAction="#chooseMode" maxWidth="Infinity" styleClass="mode-card" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Button fx:id="northern" text="北  北方麻将\n传统规制 · 经典耐玩" onAction="#chooseMode" maxWidth="Infinity" styleClass="mode-card" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Button fx:id="redCenter" text="中  红中麻将\n简单易学 · 新手友好" onAction="#chooseMode" maxWidth="Infinity" styleClass="mode-card" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        </GridPane>
                    </VBox>
                    <VBox spacing="10" styleClass="history-card">
                        <HBox><Label text="好友积分榜" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="累计积分" styleClass="section-subtitle"/></HBox>
                        <HBox spacing="12" alignment="CENTER_LEFT"><Label text="1" styleClass="rank-first"/><Label fx:id="rank1Name" styleClass="rank-name"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="rank1Score" styleClass="rank-score"/></HBox>
                        <HBox spacing="12" alignment="CENTER_LEFT"><Label text="2" styleClass="rank-number"/><Label fx:id="rank2Name" styleClass="rank-name"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="rank2Score" styleClass="rank-score"/></HBox>
                        <HBox spacing="12" alignment="CENTER_LEFT"><Label text="3" styleClass="rank-number"/><Label fx:id="rank3Name" styleClass="rank-name"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="rank3Score" styleClass="rank-score"/></HBox>
                    </VBox>
                </VBox>

                <VBox spacing="15" prefWidth="400" minWidth="370" styleClass="setup-card">
                    <VBox spacing="2"><Label text="创建或加入好友房" styleClass="setup-title"/><Label text="每台电脑控制一名玩家" styleClass="section-subtitle"/></VBox>
                    <Separator/>
                    <VBox spacing="6"><Label text="我的昵称" styleClass="field-label"/><TextField fx:id="nicknameField" promptText="请输入昵称" styleClass="player-field"/></VBox>
                    <GridPane hgap="12" vgap="11">
                        <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                        <VBox spacing="6" GridPane.columnIndex="0"><Label text="轮次" styleClass="field-label"/><ComboBox fx:id="roundsBox" maxWidth="Infinity" styleClass="form-select"/></VBox>
                        <VBox spacing="6" GridPane.columnIndex="1"><Label text="基础倍率" styleClass="field-label"/><ComboBox fx:id="multiplierBox" maxWidth="Infinity" styleClass="form-select"/></VBox>
                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label text="封顶" styleClass="field-label"/><ComboBox fx:id="scoreCapBox" maxWidth="Infinity" styleClass="form-select"/></VBox>
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="人数" styleClass="field-label"/><Label text="4 人" maxWidth="Infinity" styleClass="static-field"/></VBox>
                    </GridPane>
                    <Button text="创建好友房   ›" onAction="#createRoom" maxWidth="Infinity" styleClass="primary-button"/>
                    <HBox alignment="CENTER" spacing="9"><Separator HBox.hgrow="ALWAYS"/><Label text="或加入已有房间" styleClass="section-subtitle"/><Separator HBox.hgrow="ALWAYS"/></HBox>
                    <HBox spacing="9"><TextField fx:id="roomCodeField" promptText="输入 6 位房间码" HBox.hgrow="ALWAYS" styleClass="room-code-field"/><Button text="加入房间" onAction="#joinRoom" styleClass="secondary-button"/></HBox>
                    <Label fx:id="errorLabel" styleClass="error-label"/>
                    <Label text="需要连接房主或游戏服务器；断线后可凭会话令牌重新进入原房间。" styleClass="privacy-tip" wrapText="true"/>
                </VBox>
            </HBox>
        </center>
        <bottom><HBox alignment="CENTER_LEFT" spacing="12" styleClass="bottom-bar"><Label text="联机好友局" styleClass="bottom-title"/><Label text="房间等待 → 准备开局 → 实时牌局 → 结算排名" styleClass="bottom-copy"/><Region HBox.hgrow="ALWAYS"/><Button text="规则说明" styleClass="ghost-button"/><Button text="完整积分榜" styleClass="ghost-button"/></HBox></bottom>
    </BorderPane>
</StackPane>
