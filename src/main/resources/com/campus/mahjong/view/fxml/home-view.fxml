<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.campus.mahjong.controller.page.HomeController" styleClass="home-root">
 <BorderPane maxWidth="1440">
  <top><HBox alignment="CENTER_LEFT" spacing="14" styleClass="lobby-header">
   <StackPane styleClass="lobby-mark"><Label text="發"/></StackPane>
   <VBox spacing="2"><Label text="闹麻麻" styleClass="lobby-brand"/><Label text="好友麻将馆" styleClass="lobby-muted"/></VBox>
   <Region HBox.hgrow="ALWAYS"/><Label fx:id="profileScoreLabel" text="本机积分  0" styleClass="lobby-score-chip"/><Label text="四人一桌 · 局域网联机" styleClass="lobby-header-muted"/>
   <Button text="联机指南  ↗" onAction="#showHelp" styleClass="lobby-link"/>
  </HBox></top>
  <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="lobby-scroll">
   <content><HBox spacing="28" alignment="TOP_CENTER" styleClass="lobby-body">
    <VBox spacing="22" minWidth="460" prefWidth="700" HBox.hgrow="ALWAYS" styleClass="lobby-main-panel">
     <HBox spacing="12" alignment="CENTER_LEFT" styleClass="lobby-hero">
      <VBox spacing="9" HBox.hgrow="ALWAYS"><Label text="好 友 入 座，好 戏 开 场" styleClass="lobby-kicker"/>
       <Label text="三缺一？&#10;就等你了。" styleClass="lobby-headline"/>
       <Label text="把熟悉的人，聚在一张牌桌。" styleClass="lobby-hero-copy"/>
      </VBox><HBox fx:id="heroTiles" spacing="-5" alignment="CENTER" mouseTransparent="true"/>
     </HBox>
     <VBox spacing="12">
      <HBox alignment="CENTER_LEFT"><Label text="今天，玩哪一局？" styleClass="lobby-section"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="modeHintLabel" text="四川麻将" styleClass="lobby-selection"/></HBox>
      <GridPane hgap="12" vgap="12"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
       <Button fx:id="sichuan" onAction="#chooseMode" maxWidth="Infinity" accessibleText="四川麻将" styleClass="lobby-mode,selected" GridPane.columnIndex="0" GridPane.rowIndex="0">
        <graphic><HBox spacing="12" alignment="CENTER_LEFT"><StackPane styleClass="mode-glyph"><Label text="川"/></StackPane><VBox spacing="4"><Label text="四川麻将" styleClass="mode-name"/><Label text="缺一门 · 节奏明快" styleClass="mode-description"/></VBox></HBox></graphic>
       </Button>
       <Button fx:id="redCenter" onAction="#chooseMode" maxWidth="Infinity" accessibleText="红中麻将" styleClass="lobby-mode" GridPane.columnIndex="1" GridPane.rowIndex="0">
        <graphic><HBox spacing="12" alignment="CENTER_LEFT"><StackPane styleClass="mode-glyph"><Label text="中"/></StackPane><VBox spacing="4"><Label text="红中麻将" styleClass="mode-name"/><Label text="四川血战 · 四红中赖子" styleClass="mode-description"/></VBox></HBox></graphic>
       </Button>
      </GridPane>
      <Label text="所有玩法均采用血战到底：三家胡牌或牌墙耗尽后，自动进入下一轮。" wrapText="true" styleClass="lobby-muted"/>
     </VBox>
     <VBox spacing="11" styleClass="lobby-ranking">
      <HBox alignment="CENTER_LEFT"><Label text="牌友积分榜" styleClass="lobby-section"/><Region HBox.hgrow="ALWAYS"/><Button text="查看全部  ↗" onAction="#showRanking" styleClass="lobby-link"/></HBox>
      <HBox spacing="12" alignment="CENTER_LEFT"><Label text="01" styleClass="lobby-rank-index"/><Label fx:id="rank1Name" styleClass="lobby-rank-name"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="rank1Score" styleClass="lobby-rank-score"/></HBox>
      <HBox spacing="12" alignment="CENTER_LEFT"><Label text="02" styleClass="lobby-rank-index"/><Label fx:id="rank2Name" styleClass="lobby-rank-name"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="rank2Score" styleClass="lobby-rank-score"/></HBox>
      <HBox spacing="12" alignment="CENTER_LEFT"><Label text="03" styleClass="lobby-rank-index"/><Label fx:id="rank3Name" styleClass="lobby-rank-name"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="rank3Score" styleClass="lobby-rank-score"/></HBox>
     </VBox>
    </VBox>
    <VBox spacing="12" minWidth="330" prefWidth="380" maxWidth="400" maxHeight="700" styleClass="lobby-room-panel">
     <HBox alignment="CENTER_LEFT"><Label text="开一桌好牌" styleClass="lobby-form-title"/><Region HBox.hgrow="ALWAYS"/><Label text="4 人局" styleClass="lobby-selection"/></HBox>
     <Label text="你来定规则，好友来赴约。" styleClass="lobby-muted"/>
     <VBox spacing="7"><Label text="怎么称呼你" styleClass="lobby-field-label"/><TextField fx:id="nicknameField" promptText="输入你的牌桌昵称" styleClass="lobby-input"/></VBox>
     <GridPane hgap="12" vgap="12"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
      <VBox spacing="7"><Label text="游戏轮次" styleClass="lobby-field-label"/><ComboBox fx:id="roundsBox" maxWidth="Infinity" styleClass="lobby-select"/></VBox>
      <VBox spacing="7" GridPane.columnIndex="1"><Label text="基础倍率" styleClass="lobby-field-label"/><ComboBox fx:id="multiplierBox" maxWidth="Infinity" styleClass="lobby-select"/></VBox>
      <VBox spacing="7" GridPane.rowIndex="1" GridPane.columnSpan="2"><Label text="封顶倍数" styleClass="lobby-field-label"/><ComboBox fx:id="scoreCapBox" maxWidth="Infinity" styleClass="lobby-select"/></VBox>
     </GridPane>
     <Button fx:id="teachingButton" text="开始教学 · 三位老师陪练" onAction="#startTeaching" maxWidth="Infinity" styleClass="secondary-button"/>
     <Label text="所选玩法练习一轮 · 操作建议与点评 · 不计入排行榜" wrapText="true"/>
     <Button fx:id="createButton" text="创建好友房   →" onAction="#createRoom" maxWidth="Infinity" styleClass="lobby-create"/>
     <Label text="创建后复制邀请地址，发给同一网络中的好友。" wrapText="true" styleClass="lobby-muted"/>
     <Separator/>
     <VBox spacing="9"><Label text="好友已经开桌？" styleClass="lobby-field-label"/>
      <HBox spacing="8"><TextField fx:id="roomCodeField" promptText="粘贴完整邀请地址" onAction="#joinRoom" styleClass="lobby-input" HBox.hgrow="ALWAYS" minWidth="100"/><Button fx:id="joinButton" text="加入 ↗" onAction="#joinRoom" minWidth="74" styleClass="lobby-join"/></HBox>
     </VBox>
     <Label fx:id="errorLabel" wrapText="true" maxWidth="330" styleClass="lobby-error"/>
    </VBox>
   </HBox></content>
  </ScrollPane></center>
  <bottom><HBox spacing="12" alignment="CENTER_LEFT" styleClass="lobby-footer"><Label text="一桌四友，尽兴而归。" styleClass="lobby-footer-title"/><Region HBox.hgrow="ALWAYS"/><Label text="同一 Wi-Fi / 热点  ·  自动换轮  ·  逐笔结算" styleClass="lobby-muted"/></HBox></bottom>
 </BorderPane>
</StackPane>
